# Both the vision (blank-amount image) and text (message parsing) steps
# default to Featherless AI.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_TEXT_MODEL=Qwen/Qwen2.5-72B-Instruct
FEATHERLESS_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# Check your plan's concurrency-unit limit vs. the model's per-request cost
# (large models cost more units/request) before raising these. A 4-unit
# plan running a 4-unit-per-request model can only do 1 at a time.
FEATHERLESS_MAX_CONCURRENCY=1
FEATHERLESS_VISION_MAX_CONCURRENCY=1

# Optional: route the vision step to Gemini instead (its free tier stalls
# quickly: ~4-5 requests/minute AND a ~20/day cap). Set VISION_PROVIDER=gemini
# to use it. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_VISION_MODEL=gemini-3.6-flash

# Optional: route the vision step to Groq instead (fast, no daily cap seen
# in practice). Set VISION_PROVIDER=groq to use it. Get a free key at
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

VISION_PROVIDER=featherless
